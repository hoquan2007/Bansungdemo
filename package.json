{
  "name": "bansung-arena",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "npm run build:server && node .server-build/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "tsc --noEmit && npm run build:server && vite build",
    "smoke": "node scripts/smoke.mjs",
    "start:server": "node .server-build/server/index.js"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@colyseus/sdk": "^0.18.0",
    "colyseus": "^0.18.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
